<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_rounded_outline"
    android:orientation="horizontal"
    android:padding="@dimen/gap_small">

    <TextView
        android:id="@+id/optionNumber"
        style="@style/paragraph"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/shape_rounded_solid"
        android:gravity="center"
        android:text="1"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/optionLabel"
        style="@style/paragraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_small"
        android:text="Option"
        tools:ignore="HardcodedText" />
</LinearLayout>