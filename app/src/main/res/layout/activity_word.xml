<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingTop="48dp">

    <ProgressBar
        android:id="@+id/pB"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:paddingStart="@dimen/gap_md"
        android:paddingEnd="@dimen/gap_md"
        android:progressDrawable="@drawable/ll_progress"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWord"
        style="@style/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="@dimen/gap_md"
        android:paddingEnd="@dimen/gap_md"
        android:text="Galaxy"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintTop_toBottomOf="@+id/pB"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_md"
        android:paddingEnd="@dimen/gap_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/option1"
            layout="@layout/item_option" />

        <include
            android:id="@+id/option2"
            layout="@layout/item_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small" />

        <include
            android:id="@+id/option3"
            layout="@layout/item_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small" />

        <include
            android:id="@+id/option4"
            layout="@layout/item_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/btnSkipWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gap_md"
        android:paddingTop="@dimen/gap_md"
        android:paddingEnd="@dimen/gap_md"
        android:paddingBottom="36dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSkip"
            style="@style/paragraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_rounded_solid"
            android:backgroundTint="@color/accent"
            android:padding="@dimen/gap_small"
            android:stateListAnimator="@null"
            android:text="@string/btn_skip"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btnSuccessWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/success"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_md"
        android:paddingTop="@dimen/gap_md"
        android:paddingEnd="@dimen/gap_md"
        android:paddingBottom="36dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_like" />

            <TextView
                style="@style/paragraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/tv_correct"
                android:textColor="@color/white" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSuccess"
            style="@style/paragraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:background="@drawable/shape_rounded_solid"
            android:backgroundTint="@color/white"
            android:padding="@dimen/gap_small"
            android:stateListAnimator="@null"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:textColor="@color/success"
            app:layout_constraintBottom_toBottomOf="parent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnFailureWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/failure"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_md"
        android:paddingTop="@dimen/gap_md"
        android:paddingEnd="@dimen/gap_md"
        android:paddingBottom="36dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_dislike" />

            <TextView
                style="@style/paragraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/tv_incorrect"
                android:textColor="@color/white" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFailure"
            style="@style/paragraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:background="@drawable/shape_rounded_solid"
            android:backgroundTint="@color/white"
            android:padding="@dimen/gap_small"
            android:stateListAnimator="@null"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:textColor="@color/failure"
            app:layout_constraintBottom_toBottomOf="parent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>